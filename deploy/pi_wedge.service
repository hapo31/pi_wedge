[Unit]
Description=pi_wedge LAN slicing and printing
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=pi_wedge
WorkingDirectory=/opt/pi_wedge
EnvironmentFile=/opt/pi_wedge/.env
ExecStart=/usr/bin/node /opt/pi_wedge/dist/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pi_wedge/app

[Install]
WantedBy=multi-user.target
