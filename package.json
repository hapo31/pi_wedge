{
  "name": "pi_wedge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LAN-only slicing and print management for Bambu Lab A1 mini",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.build.json && npm run build:web",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "test:storage": "node --env-file-if-exists=.env --import tsx scripts/storage-smoke.ts",
    "profiles:prepare": "node scripts/prepare-profiles.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@hono/node-server": "^1.0.0",
    "@hono/zod-openapi": "^1.0.0",
    "basic-ftp": "^6.2.3",
    "gcode-preview": "^2.0.0",
    "hono": "^4.0.0",
    "mqtt": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swagger-ui-dist": "^5.0.0",
    "yauzl": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.12.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.4"
  }
}
