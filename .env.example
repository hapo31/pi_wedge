HOST=127.0.0.1
PORT=3000
API_TOKEN=replace-with-at-least-32-random-characters
DATA_DIR=./.data/app
STORAGE_BACKEND=s3
S3_ENDPOINT=http://127.0.0.1:8333
S3_BUCKET=pi-wedge
S3_ACCESS_KEY=pi-wedge
S3_SECRET_KEY=replace-with-a-random-storage-secret
# Production default: /var/lib/pi_wedge; dev: ./.data/seaweedfs
SEAWEED_DATA_DIR=/var/lib/pi_wedge
SEAWEED_IMAGE=chrislusf/seaweedfs:4.48
MAX_UPLOAD_MB=50
MAX_ARTIFACT_MB=200
MAX_PREVIEW_MB=32
SLICE_CONCURRENCY=1
MAX_QUEUED_JOBS=20
COMMAND_TIMEOUT_MS=600000
# native: Raspberry Pi OS Debian13 + installed CLI; docker: isolated tools image (Debian12 compatible)
TOOLS_BACKEND=native
TOOLS_IMAGE=pi-wedge-tools:0.1
# docker mode: /opt/squashfs-root/AppRun
ORCA_BIN=/opt/orcaslicer/AppRun
ORCA_XVFB=false
PROFILE_DIR=./profiles/generated
FREECAD_PYTHON=/usr/bin/python3
FREECAD_MODULE_PATH=/usr/lib/freecad-python3/lib
PRINTER_ENABLED=false
PRINTER_HOST=
PRINTER_SERIAL=
PRINTER_ACCESS_CODE=
# Set trusted self-signed CA; insecure TLS is an explicit opt-in for isolated LAN testing.
PRINTER_CA_FILE=
PRINTER_INSECURE_TLS=false
PRINTER_TIMEOUT_MS=30000
